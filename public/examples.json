[
  {
    "label": "GitHub: popular repos of an org, stored in MongoDB",
    "input": { "org": "nestjs", "minStars": 1000 },
    "workflow": {
      "name": "popular-repos",
      "input": {
        "org": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "minStars": { "type": "integer", "minimum": 0, "default": 1000 },
        "apiUrl": { "type": "string", "default": "https://api.github.com" }
      },
      "steps": [
        {
          "id": "fetch",
          "task": "http.request",
          "params": {
            "url": "{{ input.apiUrl }}/search/repositories",
            "query": { "q": "org:{{ input.org }}", "sort": "stars", "order": "desc", "per_page": 100 },
            "headers": { "Accept": "application/vnd.github+json" }
          },
          "dependsOn": []
        },
        {
          "id": "popular",
          "task": "filter",
          "params": {
            "items": "{{ steps.fetch.output.body.items }}",
            "where": "stargazers_count >= $minStars",
            "vars": { "minStars": "{{ input.minStars }}" }
          },
          "dependsOn": ["fetch"]
        },
        {
          "id": "summary",
          "task": "transform",
          "params": {
            "value": "{{ steps.popular.output.{ 'name': full_name, 'stars': stargazers_count, 'language': language }[] }}"
          },
          "dependsOn": ["popular"]
        },
        {
          "id": "save",
          "task": "mongo.insert",
          "params": {
            "collection": "repos",
            "documents": { "org": "{{ input.org }}", "repos": "{{ steps.summary.output }}" },
            "timestampField": "timestamp"
          },
          "dependsOn": ["summary"]
        }
      ]
    }
  },
  {
    "label": "GitHub: two filters from one fetch (nothing stored)",
    "input": { "org": "facebook" },
    "workflow": {
      "name": "branching-example",
      "input": { "org": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" } },
      "steps": [
        {
          "id": "fetch",
          "task": "http.request",
          "params": {
            "url": "https://api.github.com/search/repositories",
            "query": { "q": "org:{{ input.org }}", "sort": "stars", "order": "desc", "per_page": 100 }
          },
          "dependsOn": []
        },
        {
          "id": "popular",
          "task": "filter",
          "params": { "items": "{{ steps.fetch.output.body.items }}", "where": "stargazers_count >= 10000" },
          "dependsOn": ["fetch"]
        },
        {
          "id": "huge",
          "task": "filter",
          "params": { "items": "{{ steps.fetch.output.body.items }}", "where": "stargazers_count >= 50000" },
          "dependsOn": ["fetch"]
        }
      ]
    }
  },
  {
    "label": "Invalid: reads a step it does not depend on",
    "input": {},
    "workflow": {
      "name": "undeclared-dependency",
      "steps": [
        { "id": "a", "task": "transform", "params": { "value": 1 }, "dependsOn": [] },
        { "id": "b", "task": "transform", "params": { "value": "{{ steps.a.output + 1 }}" }, "dependsOn": [] }
      ]
    }
  },
  {
    "label": "Invalid: params that break the task's schema",
    "input": {},
    "workflow": {
      "name": "bad-params",
      "steps": [
        { "id": "call", "task": "http.request", "params": { "method": "FETCH", "timeoutMs": 0 }, "dependsOn": [] }
      ]
    }
  },
  {
    "label": "Invalid: circular dependency",
    "input": {},
    "workflow": {
      "name": "cycle-example",
      "steps": [
        { "id": "a", "task": "transform", "params": { "value": 1 }, "dependsOn": ["b"] },
        { "id": "b", "task": "transform", "params": { "value": 2 }, "dependsOn": ["a"] }
      ]
    }
  }
]
